{
    // "editor.formatOnSave": false,
    "liveServer.settings.donotShowInfoMsg": true,
    "liveServer.settings.donotVerifyTags": true,
    "liveSassCompile.settings.formats": [
        {
            "format": "expanded",
            "extensionName": ".css",
            "savePath": "/asset/style/css/pages",
        },
    ],
    "liveSassCompile.settings.generateMap": true,
    "editor.stickyScroll.enabled": false,
    "terminal.background": "#2c2c54",
    "diffEditor.hideUnchangedRegions.enabled": true,
    "html-css-class-completion.enableEmmetSupport": true,
    "html-css-class-completion.JavaScriptLanguages": [
        "javascript",
        "javascriptreact",
        "typescriptreact",
    ],
    "files.autoSave": "afterDelay",
    "editor.formatOnType": false,
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "[javascriptreact]": {
        "editor.defaultFormatter": "vscode.typescript-language-features",
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "editor.cursorBlinking": "expand",
    "terminal.integrated.cursorBlinking": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "terminal.integrated.smoothScrolling": true,
    "editor.guides.highlightActiveBracketPair": false,
    "[php]": {
        "editor.defaultFormatter": "DEVSENSE.phptools-vscode",
    },
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4o-mini",
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "geminicodeassist.inlineSuggestions.enableAuto": true,
    "diffEditor.codeLens": true,
    "liveSassCompile.settings.includeItems": [],
    "window.commandCenter": true,
    "workbench.activityBar.orientation": "vertical",
    "supermaven.otherWarning": false,
    "json.schemas": [],
    "workbench.editorAssociations": {
        "*.sqlite": "sqlite3-editor.optional"
    },
    "workbench.iconTheme": "material-icon-theme",
    "[blade]": {
        "editor.defaultFormatter": "DEVSENSE.phptools-vscode",
    },
    "AI.toolcall.autoRun.command.denyList": "[\"rm\",\"chmod\"]",
    // Base Color Theme
    "workbench.colorTheme": "Andromeda",
    // Font and Basic Editor Settings
    "editor.fontFamily": "'Fira Code', 'JetBrains Mono', Consolas, 'Courier New', monospace",
    "editor.fontLigatures": true,
    // "editor.fontSize": 17,
    "editor.tabSize": 3,
    // "editor.fontWeight": "400",
    "editor.insertSpaces": true,
    // "editor.renderWhitespace": "boundary",
    "workbench.colorCustomizations": {
        // "[Andromeda Bordered]": {
        //     // Apnar active theme-er opor customization
        //     "editor.background": "#171b26", // Screenshot-er moto dark charcoal background
        //     "editor.foreground": "#D4D4D4", // Sadharon text-er rong
        //     "editorLineNumber.foreground": "#858585", // Line number-er rong
        //     "editorCursor.foreground": "#AEAFAD", // Cursor-er rong
        // },
        // Shob panel, sidebar ebong chat-er lekha ujjol shada korbe
        "foreground": "#F0F0F0",
        
        // Chat panel ebong input box-er contrast thik korbe
        "chat.requestBackground": "#1e2230",
        "chat.slashCommandBackground": "#2d3548",
        
        // Andromeda theme-er jonno active settings
        "[Andromeda]": {
            "editor.background": "#171b26",
            "editor.foreground": "#D4D4D4",
            "editorLineNumber.foreground": "#A0A0A0",
            "editorCursor.foreground": "#AEAFAD",
            "sideBar.foreground": "#cecdcd",
            "sideBarSectionHeader.foreground": "#FFFFFF"
        }
    },
    "editor.tokenColorCustomizations": {
        "[Andromeda]": {
            // Apnar active theme-er opor customization
            "textMateRules": [
                {
                    "scope": [
                        "comment",
                        "punctuation.definition.comment",
                        "comment.block.blade", // Blade comment-er jonno
                    ],
                    "settings": {
                        "foreground": "#808080",
                    },
                },
                {
                    "name": "Tag Brackets", // Tag bracket-er jonno notun rule
                    "scope": [
                        "punctuation.definition.tag.begin", // Opening bracket < and </
                        "punctuation.definition.tag.end", // Closing bracket >
                    ],
                    "settings": {
                        "foreground": "#FFFFFF",
                    },
                },
                {
                    "scope": [
                        "entity.name.tag", // HTML/XML tag name
                        "meta.tag",
                    ],
                    "settings": {
                        "foreground": "#f2858c",
                    },
                },
                {
                    "scope": [
                        "entity.other.attribute-name", // HTML/XML attribute name
                    ],
                    "settings": {
                        "foreground": "#ded47e",
                    },
                },
                {
                    "name": "Attribute equals sign", // Attribute-er '=' sign-er jonno notun rule
                    "scope": [
                        "punctuation.separator.key-value.html",
                        "punctuation.separator.key-value.xml",
                        "keyword.operator.assignment", // JavaScript/PHP-te '=' er jonno o kaj korte pare
                    ],
                    "settings": {
                        "foreground": "#ffffff",
                    },
                },
                {
                    "name": "String Punctuation (Quotes)", // Quotes-er jonno notun rule
                    "scope": [
                        "punctuation.definition.string.begin", // String-er shurur quote
                        "punctuation.definition.string.end", // String-er shesher quote
                    ],
                    "settings": {
                        "foreground": "#82d99f",
                    },
                },
                {
                    "scope": [
                        "string", // String value
                        "punctuation.definition.string",
                        "string.quoted.double.html", // HTML attribute value (double quoted)
                        "string.quoted.single.html", // HTML attribute value (single quoted)
                    ],
                    "settings": {
                        "foreground": "#70cb98",
                    },
                },
                {
                    "scope": [
                        "keyword",
                        "storage.type",
                        "storage.modifier"
                    ],
                    "settings": {
                        "foreground": "#569CD6", // Keyword-er rong (nil)
                    },
                },
                {
                    "scope": [
                        "variable",
                        "support.variable",
                        "entity.name.variable"
                    ],
                    "settings": {
                        "foreground": "#4EC9B0", // Variable-er rong (halka shobuj-nil)
                    },
                },
                {
                    "scope": "constant.numeric",
                    "settings": {
                        "foreground": "#cea8c9", // Number-er rong (halka shobuj)
                    },
                },
            ],
        },
    },
    "editor.linkedEditing": true,
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*",
    },
    "editor.wordWrapColumn": 100,
    "cursor.general.disableHttp2": true,
    "supermaven.enableFixWithSupermaven": true,
    "editor.minimap.enabled": false,
    "github.copilot.nextEditSuggestions.enabled": true,
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "git.autorefresh": true,
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features",
    },
    "git.autoRepositoryDetection": true,
    "supermaven.enable": {
        "php": true,
    },
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
        "php": false,
    },
    "diffEditor.ignoreTrimWhitespace": false,
    "terminal.integrated.stickyScroll.enabled": false,
    "sqlite3-editor.ui.tableSelector.displayColumns": false,
    "sqlite3-editor.ui.tableSelector.displayShadowTables": true,
    "chat.instructionsFilesLocations": {
        ".github/instructions": true,
        "C:\\Users\\MDASHI~1\\AppData\\Local\\Temp\\postman-collections-post-response.instructions.md": true,
        "C:\\Users\\MDASHI~1\\AppData\\Local\\Temp\\postman-collections-pre-request.instructions.md": true,
        "C:\\Users\\MDASHI~1\\AppData\\Local\\Temp\\postman-folder-post-response.instructions.md": true,
        "C:\\Users\\MDASHI~1\\AppData\\Local\\Temp\\postman-folder-pre-request.instructions.md": true,
        "C:\\Users\\MDASHI~1\\AppData\\Local\\Temp\\postman-http-request-post-response.instructions.md": true,
        "C:\\Users\\MDASHI~1\\AppData\\Local\\Temp\\postman-http-request-pre-request.instructions.md": true,
    },
    "postman.mcp.notifications.postmanMCP": false,
    // config related to code formatting
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": false,
    "[javascript]": {
